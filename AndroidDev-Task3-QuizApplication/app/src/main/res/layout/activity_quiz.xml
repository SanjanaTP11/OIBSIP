<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F2F5FC">

    <TextView
        android:id="@+id/tvCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QUESTION 1 OF 10"
        android:textSize="14sp"
        android:textColor="#3949AB"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:padding="10dp"
        android:background="#E0E7FF"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YOUR CHALLENGE"
        android:textSize="13sp"
        android:textColor="#777777"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Question appears here"
        android:textSize="25sp"
        android:textColor="#202747"
        android:textStyle="bold"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="28dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CHOOSE YOUR ANSWER"
        android:textSize="13sp"
        android:textColor="#666666"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginBottom="12dp" />

    <RadioGroup
        android:id="@+id/rgOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:text="Option 1"
            android:textSize="17sp"
            android:textColor="#252B40"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/option_background"
            android:buttonTint="#3949AB"
            android:checked="false" />

        <RadioButton
            android:id="@+id/rb2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:text="Option 2"
            android:textSize="17sp"
            android:textColor="#252B40"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/option_background"
            android:buttonTint="#3949AB"
            android:checked="false" />

        <RadioButton
            android:id="@+id/rb3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:text="Option 3"
            android:textSize="17sp"
            android:textColor="#252B40"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/option_background"
            android:buttonTint="#3949AB"
            android:checked="false" />

        <RadioButton
            android:id="@+id/rb4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:text="Option 4"
            android:textSize="17sp"
            android:textColor="#252B40"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/option_background"
            android:buttonTint="#3949AB"
            android:checked="false" />

    </RadioGroup>

    <Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="Next"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3949AB"
        android:layout_marginTop="20dp" />

</LinearLayout>
