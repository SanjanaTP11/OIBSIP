<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#F2F5FC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🧠"
        android:textSize="64sp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QUIZ TIME"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#233876"
        android:letterSpacing="0.08"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Your General Knowledge!"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Challenge yourself with 10 exciting questions and see how much you know."
        android:textSize="16sp"
        android:textColor="#666666"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:layout_marginBottom="36dp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="START QUIZ"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3949AB"
        android:layout_marginHorizontal="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Learn • Play • Improve"
        android:textSize="14sp"
        android:textColor="#777777"
        android:layout_marginTop="32dp" />

</LinearLayout>
